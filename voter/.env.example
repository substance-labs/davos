# Database Configuration
MONGODB_URI=mongodb://davos:voterpassword@mongodb:27017/davos-voter?authSource=admin

# Snapshot Configuration
SNAPSHOT_HUB_URL=https://hub.snapshot.org/graphql

# Blockchain Settings
RPC_URL=
TALLY_RPC_URL=

# Private Key (for agent signing - KEEP SECURE!)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Smart Contract Addresses
DELEGATE_CONTRACT_ADDRESS=0xYOUR_DELEGATE_CONTRACT_ADDRESS

# KeyringGateway Address
KEYRING_GATEWAY_POLYGON=0xYOUR_KEYRING_GATEWAY_POLYGON_ADDRESS

# Chain Configuration
REL_CHAIN=polygon

# Schedule Settings (cron format)
# Default: Every hour at minute 0
FETCH_SCHEDULE=0 * * * *

# API Configuration
API_PORT=3000

# Tally API
# Get your API key from https://www.tally.xyz/api
TALLY_API_KEY=YOUR_TALLY_API_KEY_HERE

# OpenAI Configuration
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY_HERE

# AI Parser Settings
AI_DIRECTIVE="Suggest a vote for the passed proposal based on the ethos of the user. The result must be only a JSON with two elements: 'vote', which can be yes or no, and 'reason', which is the explanation of the reasons considered for the voting decision. The JSON must be formatted as follows: {\"vote\": \"yes\", \"reason\": \"...\"}."
AI_MODEL=gpt-4o

# Optional: Node Environment
NODE_ENV=development
